<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            prefWidth="1366.0" prefHeight="768.0"
            minWidth="1100.0" minHeight="650.0"
            stylesheets="@/css/Detalhes.css"
            fx:controller="sys.patrimonio.view.controller.ControllerCautelas">

    <!-- MENU LATERAL -->
    <left>
        <fx:include fx:id="sidebar" source="/view/sidebar.fxml"/>
    </left>

    <!-- CONTEÚDO -->
    <center>
        <VBox spacing="18.0" styleClass="content">
            <padding>
                <Insets top="24.0" right="26.0" bottom="20.0" left="26.0"/>
            </padding>

            <!-- CABEÇALHO -->
            <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Cautela" styleClass="page-title"/>
                    <Label text="Consulte as cautelas registradas"
                           styleClass="page-subtitle"/>
                </VBox>
            </HBox>

            <!-- INDICADORES -->
            <HBox spacing="14.0" styleClass="summary-row">
                <HBox spacing="16.0" alignment="CENTER"
                      styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label text="▤" styleClass="summary-icon"/>
                    <VBox spacing="4.0">
                        <Label text="Total de Cautelas" styleClass="summary-label"/>
                        <Label fx:id="totalCautelasLabel" text="-1"
                               styleClass="summary-value"/>
                    </VBox>
                </HBox>

                <HBox spacing="16.0" alignment="CENTER"
                      styleClass="summary-card" HBox.hgrow="ALWAYS">
                    <Label text="▦" styleClass="summary-icon"/>
                    <VBox spacing="4.0">
                        <Label text="Última Cautela" styleClass="summary-label"/>
                        <Label fx:id="ultimaCautelaLabel" text="31/02/2026"
                               styleClass="summary-date"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- BUSCA -->
            <HBox alignment="CENTER" spacing="10.0" styleClass="search-card" maxWidth="400.0">
                <Label text="⌕" styleClass="search-icon"/>
                <TextField fx:id="buscarIdField"
                           promptText="Buscar por ID..."
                           styleClass="search-field"/>
                <Button prefHeight="40.0" prefWidth="110.0"
                        styleClass="button-search" text="Pesquisar" onAction="#pesquisaCautelas"/>
            </HBox>

            <!-- HISTÓRICO -->
            <VBox spacing="12.0" styleClass="table-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="☷" styleClass="section-icon"/>
                    <Label fx:id="textoResultado" text="Últimas 5 Cautelas" styleClass="section-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <TableView fx:id="tabela_cautelas" styleClass="cautelas-table"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="80.0"/>
                        <TableColumn fx:id="itemColumn" text="Item" prefWidth="250.0"/>
                        <TableColumn fx:id="localOrigemColumn" text="Origem" prefWidth="180.0"/>
                        <TableColumn fx:id="localDestinoColumn" text="Destino" prefWidth="180.0"/>
                        <TableColumn fx:id="tomboColumn" text="Tombo" prefWidth="222.0"/>
                        <TableColumn fx:id="dataColumn" text="Data" prefWidth="150.0"/>
                    </columns>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8.0">
                            <Label text="Nenhuma cautela encontrada" styleClass="empty-title"/>
                            <Label text="Os registros aparecerão aqui." styleClass="empty-subtitle"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>
