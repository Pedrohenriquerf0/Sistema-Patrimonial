<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<AnchorPane
        prefHeight="768.0"
        prefWidth="1366.0"
        stylesheets="@/css/home.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="sys.patrimonio.view.controller.ControllerCautelas">

    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <!-- MENU LATERAL -->
            <left>
                <fx:include fx:id="sidebar" source="/view/sidebar.fxml"/>
            </left>


            <!-- ÁREA PRINCIPAL -->
            <center>

                <VBox spacing="20.0" styleClass="content">

                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                    </padding>


                    <!-- CABEÇALHO -->

                    <VBox spacing="5.0">

                        <Label styleClass="title" text="Cautelas"/>
                        <Label styleClass="subtitle" text="Consulte e gerencie as cautelas no sistema."/>

                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-card">

                        <TextField fx:id="text_pesquisa" prefHeight="40.0"
                                   promptText="Pesquisar id..."
                                   styleClass="search-field" HBox.hgrow="ALWAYS"/>

                        <Button onAction="#pesquisaCautelas" prefHeight="40.0" prefWidth="110.0"
                                styleClass="button-search" text="Pesquisar"/>

                    </HBox>

                    <VBox styleClass="table-card" VBox.vgrow="ALWAYS" spacing="24.0">

                    </VBox>
                </VBox>
            </center>
        </BorderPane>

    </children>

</AnchorPane>
