<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="sys.patrimonio.view.controller.ControllerMovimentacaoCard"
      spacing="8.0"
      styleClass="movimentacao-card">

    <padding>
        <Insets top="12.0" right="12.0"
                bottom="12.0" left="12.0"/>
    </padding>

    <!-- Linha superior: título e indicador -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">

        <Label fx:id="label_tipo_titulo"
               text="Entrada"
               styleClass="movimentacao-titulo"
               HBox.hgrow="ALWAYS"/>

        <Label fx:id="label_tipo_badge"
               text="Entrada"
               styleClass="movimentacao-badge"/>

    </HBox>

    <!-- Linha do patrimônio -->
    <HBox alignment="CENTER_LEFT" spacing="10.0">

        <Label fx:id="label_icone"
               text="↙"
               styleClass="movimentacao-icone"/>

        <Label fx:id="label_patrimonio"
               text="Computador Dell · Tombo PAT-001"
               styleClass="movimentacao-patrimonio"
               HBox.hgrow="ALWAYS"/>

    </HBox>

    <!-- Data e quantidade -->
    <Label fx:id="label_detalhes"
           text="22/10/2026 · Quantidade: 1"
           styleClass="movimentacao-detalhes"/>

</VBox>
