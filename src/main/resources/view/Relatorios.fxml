<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import java.lang.String?>
<AnchorPane
        prefHeight="768.0"
        prefWidth="1366.0"
        stylesheets="@/css/relatorios.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="sys.patrimonio.view.controller.ControllerRelatorios">
    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <!-- MENU LATERAL -->
            <left>
                <fx:include fx:id="sidebar" source="/view/sidebar.fxml"/>
            </left>


            <!-- Conteúdo principal -->
            <center>
                <VBox spacing="22.0" styleClass="content">

                    <padding>
                        <Insets top="30.0" right="30.0"
                                bottom="30.0" left="30.0"/>
                    </padding>

                    <!-- Cabeçalho -->
                    <VBox spacing="6">
                        <Label text="Relatórios Patrimoniais"
                               styleClass="title"/>

                        <Label
                                text="Consulte indicadores e gere relatórios dos bens patrimoniais."
                                styleClass="subtitle"/>
                    </VBox>


                    <!-- CARTÕES DE INDICADORES -->
                    <HBox spacing="18.0" styleClass="indicadores-container">

                        <!-- CARTÃO AZUL: TOTAL DE PATRIMÔNIOS PATRIMONIADO E CONSUMO -->
                        <VBox spacing="8.0"
                              styleClass="indicador-card"
                              HBox.hgrow="ALWAYS">
                            <styleClass>
                                <String fx:value="indicador-azul"/>
                            </styleClass>

                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <Label text="◇" styleClass="indicador-icone"/>

                                <VBox spacing="4.0">
                                    <Label fx:id="totalPatrimonios" text="1.248" styleClass="indicador-valor"/>
                                    <Label text="Total de Patrimônios"
                                           styleClass="indicador-descricao"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- CARTÃO VERDE: ATIVOS -->
                        <VBox spacing="8.0"
                              styleClass="indicador-card"
                              HBox.hgrow="ALWAYS">
                            <styleClass>
                                <String fx:value="indicador-verde"/>
                            </styleClass>

                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <Label text="📌" styleClass="indicador-icone"/>

                                <VBox spacing="4.0">
                                    <Label fx:id="patrimonios" text="1.102" styleClass="indicador-valor"/>
                                    <Label text="Itens Patrimoniados"
                                           styleClass="indicador-descricao"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- CARTÃO LARANJA: EM MANUTENÇÃO -->
                        <VBox spacing="8.0"
                              styleClass="indicador-card"
                              HBox.hgrow="ALWAYS">
                            <styleClass>
                                <String fx:value="indicador-laranja"/>
                            </styleClass>

                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <Label text="📦" styleClass="indicador-icone"/>

                                <VBox spacing="4.0">
                                    <Label fx:id="consumos" text="98" styleClass="indicador-valor"/>
                                    <Label text="Itens de Consumos"
                                           styleClass="indicador-descricao"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- CARTÃO ROXO: BAIXADOS -->
                        <VBox spacing="8.0"
                              styleClass="indicador-card"
                              HBox.hgrow="ALWAYS">
                            <styleClass>
                                <String fx:value="indicador-roxo"/>
                            </styleClass>

                            <HBox alignment="CENTER_LEFT" spacing="14.0">
                                <Label text="▤" styleClass="indicador-icone"/>

                                <VBox spacing="4.0">
                                    <Label text="48" styleClass="indicador-valor"/>
                                    <Label text="Baixados"
                                           styleClass="indicador-descricao"/>
                                </VBox>
                            </HBox>
                        </VBox>

                    </HBox>


                    <!-- Filtros -->
                    <VBox spacing="14.0" styleClass="table-card">

                        <Label text="Filtros de pesquisa"
                               styleClass="section-title"/>

                        <HBox spacing="16.0" alignment="BOTTOM_LEFT">

                            <VBox spacing="7.0"
                                  HBox.hgrow="ALWAYS">
                                <Label text="Data inicial"
                                       styleClass="field-label"/>
                                <DatePicker fx:id="dataInicial"
                                            promptText="Data inicial"
                                            maxWidth="Infinity"
                                            editable="false"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  HBox.hgrow="ALWAYS">
                                <Label text="Data final"
                                       styleClass="field-label"/>
                                <DatePicker fx:id="dataFinal"
                                            promptText="Data final"
                                            maxWidth="Infinity"
                                            editable="false"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  HBox.hgrow="ALWAYS">
                                <Label text="Categoria"
                                       styleClass="field-label"/>
                                <ComboBox fx:id="comboCategoria"
                                          promptText="Todas"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  HBox.hgrow="ALWAYS">
                                <Label text="Localidade"
                                       styleClass="field-label"/>
                                <ComboBox fx:id="comboLocalidade"
                                          promptText="Todas"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="7.0"
                                  HBox.hgrow="ALWAYS">
                                <Label text="Status"
                                       styleClass="field-label"/>
                                <ComboBox fx:id="comboStatus"
                                          promptText="Todos"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">

                                <Button text="Gerar relatório"
                                        maxWidth="Infinity"
                                        styleClass="button-gerar"
                                        onAction="#gerarRelatorio"/>

                                <Button text="Limpar filtros"
                                        maxWidth="Infinity"
                                        styleClass="button-limpar"
                                        onAction="#limparFiltros"/>
                            </VBox>
                        </HBox>

                        <!-- Tabela -->
                        <VBox spacing="16.0"
                              styleClass="section-card"
                              VBox.vgrow="ALWAYS">

                            <HBox alignment="CENTER_LEFT"
                                  spacing="12.0">

                                <Label text="Relatórios recentes"
                                       styleClass="section-title"/>

                                <HBox HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <TableView fx:id="tabelaRelatorios"
                                       styleClass="patrimonio-table"
                                       VBox.vgrow="ALWAYS">

                                <columns>
                                    <TableColumn fx:id="colTipo"
                                                 text="Tipo de relatório"
                                                 prefWidth="242.0"/>

                                    <TableColumn fx:id="colPeriodo"
                                                 text="Período"
                                                 prefWidth="232.0"/>

                                    <TableColumn fx:id="colGeradoEm"
                                                 text="Gerado em"
                                                 prefWidth="182.0"/>

                                    <TableColumn fx:id="colQuantidade"
                                                 text="Quantudade"
                                                 prefWidth="182.0"/>

                                    <TableColumn fx:id="colAcoes"
                                                 text="Ações"
                                                 prefWidth="192.0"/>
                                </columns>

                            </TableView>
                        </VBox>


                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="labelTotal"
                                   text="Nenhum relatório gerado"
                                   styleClass="table-footer"/>
                        </HBox>

                    </VBox>

                </VBox>
            </center>

        </BorderPane>

    </children>

</AnchorPane>
