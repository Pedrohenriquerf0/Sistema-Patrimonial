<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        prefHeight="768.0"
        prefWidth="1366.0"
        stylesheets="@../view/style.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="sys.patrimonio.view.controller.ControllerHome">

    <children>

        <BorderPane
                AnchorPane.bottomAnchor="0.0"
                AnchorPane.leftAnchor="0.0"
                AnchorPane.rightAnchor="0.0"
                AnchorPane.topAnchor="0.0">

            <!-- MENU LATERAL -->
            <left>

                <VBox
                        prefWidth="230.0"
                        spacing="10.0"
                        styleClass="sidebar">

                    <padding>
                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0"/>
                    </padding>

                    <!-- TÍTULO -->
                    <Label
                            text="SISTEMA DE PATRIMÔNIO"
                            styleClass="logo"/>

                    <Label
                            text="MENU"
                            styleClass="menu-title"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="⌂   Início"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="+   Cadastrar Patrimônio"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="☷   Listar Patrimônio"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="⌖   Localidades"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="◆   Categorias"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="◆   Tipos de Ativo"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="▥   Relatórios"
                            styleClass="menu-button"/>

                    <Button
                            maxWidth="1.7976931348623157E308"
                            text="⚙   Configurações"
                            styleClass="menu-button"/>

                </VBox>

            </left>


            <!-- ÁREA PRINCIPAL -->
            <center>

                <VBox
                        spacing="20.0"
                        styleClass="content">

                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                    </padding>


                    <!-- CABEÇALHO -->

                    <VBox spacing="5.0">

                        <Label
                                text="Patrimônios"
                                styleClass="title"/>

                        <Label
                                text="Consulte e gerencie os patrimônios cadastrados no sistema."
                                styleClass="subtitle"/>

                    </VBox>


                    <!-- BARRA DE PESQUISA -->

                    <HBox
                            alignment="CENTER_LEFT"
                            spacing="10.0"
                            styleClass="search-card">

                        <TextField
                                fx:id="text_pesquisa"
                                prefHeight="40.0"
                                HBox.hgrow="ALWAYS"
                                promptText="Pesquisar por nome, tombo ou número de série..."
                                styleClass="search-field"/>

                        <Button
                                fx:id="btt_pesquisa"
                                onAction="#pesquisaPatrimonio"
                                prefHeight="40.0"
                                prefWidth="110.0"
                                text="Pesquisar"
                                styleClass="button-search"/>

                        <Button
                                fx:id="btt_adicionar"
                                onAction="#adicionarPatrimonio"
                                prefHeight="40.0"
                                prefWidth="130.0"
                                text="+ Adicionar"
                                styleClass="button-add"/>

                    </HBox>


                    <!-- TABELA -->

                    <VBox
                            VBox.vgrow="ALWAYS"
                            styleClass="table-card">

                        <Label
                                text="Lista de Patrimônios"
                                styleClass="section-title"/>

                        <TableView
                                fx:id="tabela_view"
                                VBox.vgrow="ALWAYS"
                                styleClass="patrimonio-table">

                            <columns>

                                <TableColumn
                                        prefWidth="100.0"
                                        text="FOTO"/>

                                <TableColumn
                                        prefWidth="250.0"
                                        text="MATERIAL"/>

                                <TableColumn
                                        prefWidth="130.0"
                                        text="TOMBO"/>

                                <TableColumn
                                        prefWidth="180.0"
                                        text="Nº SÉRIE"/>

                                <TableColumn
                                        prefWidth="160.0"
                                        text="CATEGORIA"/>

                                <TableColumn
                                        prefWidth="160.0"
                                        text="TIPO DE ATIVO"/>

                                <TableColumn
                                        prefWidth="180.0"
                                        text="LOCALIDADE"/>

                                <TableColumn
                                        prefWidth="100.0"
                                        text="QUANTIDADE"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>