<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane
        prefHeight="768.0"
        prefWidth="1366.0"
        stylesheets="@css/style.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="sys.patrimonio.view.controller.ControllerHome">
    <children>

        <BorderPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="0.0">

            <!-- MENU LATERAL -->
            <left>

                <VBox prefWidth="230.0" spacing="10.0" styleClass="sidebar">

                    <padding>
                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0"/>
                    </padding>

                    <!-- TÍTULO -->
                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="logo"
                           text="SISTEMA DE PATRIMÔNIO"/>

                    <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="menu-title" text="MENU"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="⌂   Início"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="+   Cadastrar Patrimônio"
                            onAction="#Cadastrar_Patrimônio"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="☷   Listar Patrimônio"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="⌖   Localidades"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="◆   Categorias"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="◆   Tipos de Ativo"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="▥   Relatórios"/>

                    <Button maxWidth="1.7976931348623157E308" styleClass="menu-button" text="⚙   Configurações"/>

                </VBox>

            </left>


            <!-- ÁREA PRINCIPAL -->
            <center>

                <VBox spacing="20.0" styleClass="content">

                    <padding>
                        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
                    </padding>


                    <!-- CABEÇALHO -->

                    <VBox spacing="5.0">

                        <Label styleClass="title" text="Patrimônios"/>

                        <Label styleClass="subtitle" text="Consulte e gerencie os patrimônios cadastrados no sistema."/>

                    </VBox>


                    <!-- BARRA DE PESQUISA -->

                    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="search-card">

                        <TextField fx:id="text_pesquisa" prefHeight="40.0"
                                   promptText="Pesquisar por nome, tombo ou número de série..."
                                   styleClass="search-field" HBox.hgrow="ALWAYS"/>

                        <Button fx:id="btt_pesquisa" onAction="#pesquisaPatrimonio" prefHeight="40.0" prefWidth="110.0"
                                styleClass="button-search" text="Pesquisar"/>

                    </HBox>


                    <!-- TABELA -->

                    <VBox styleClass="table-card" VBox.vgrow="ALWAYS">

                        <Label styleClass="section-title" text="Lista de Patrimônios"/>

                        <TableView fx:id="tabela_view" styleClass="patrimonio-table" VBox.vgrow="ALWAYS">

                            <columns>

                                <TableColumn prefWidth="100.0" text="FOTO"/>

                                <TableColumn prefWidth="250.0" text="MATERIAL"/>

                                <TableColumn prefWidth="130.0" text="TOMBO"/>

                                <TableColumn prefWidth="180.0" text="Nº SÉRIE"/>

                                <TableColumn prefWidth="160.0" text="CATEGORIA"/>

                                <TableColumn prefWidth="160.0" text="TIPO DE ATIVO"/>

                                <TableColumn prefWidth="180.0" text="LOCALIDADE"/>

                                <TableColumn prefWidth="100.0" text="QUANTIDADE"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </center>

        </BorderPane>

    </children>

</AnchorPane>
