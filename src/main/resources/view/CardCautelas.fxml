<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@/css/CardDetalhes.css"
      styleClass="card-lista"
      spacing="20">

    <HBox fx:id="cardItem" styleClass="card-item entrada"
          alignment="CENTER_LEFT"
          spacing="14">

        <VBox alignment="CENTER" spacing="10">
            <ImageView fitWidth="24.0"
                       fitHeight="24.0"
                       preserveRatio="true">
                <image>
                    <Image fx:id="iconsIO" url="@/icons/arrow-square-up-right.png"/>
                </image>
            </ImageView>
        </VBox>

        <VBox spacing="5"
              minWidth="0"
              HBox.hgrow="ALWAYS">

            <Label fx:id="textoIO" text="Entrada"
                   styleClass="card-titulo"/>

            <Label fx:id="textoPatrimonio" text="Computador Dell · Tombo PAT-001"
                   styleClass="card-descricao"/>

            <Label fx:id="textoQuantidade" text="22/10/2026 · Quantidade: 1"
                   styleClass="card-detalhe"/>
        </VBox>

        <Label fx:id="textoIO2" text="Entrada"
               styleClass="card-badge"/>
    </HBox>

    <Separator/>

    <!-- ===== 2) SAÍDA ===== -->
    <HBox styleClass="card-item saida"
          alignment="CENTER_LEFT"
          spacing="14">

        <ImageView fitWidth="24.0"
                   fitHeight="24.0"
                   preserveRatio="true">
            <image>
                <Image url="@/icons/arrow-square-down-left.png"/>
            </image>
        </ImageView>

        <VBox spacing="2"
              minWidth="0"
              HBox.hgrow="ALWAYS">

            <Label text="Saída"
                   styleClass="card-titulo"/>

            <Label text="Monitor Samsung · Tombo PAT-002"
                   styleClass="card-descricao"/>

            <Label text="22/10/2026 · Quantidade: 1"
                   styleClass="card-detalhe"/>
        </VBox>

        <Label text="Saída"
               styleClass="card-badge"/>
    </HBox>

    <Separator/>
</VBox>
